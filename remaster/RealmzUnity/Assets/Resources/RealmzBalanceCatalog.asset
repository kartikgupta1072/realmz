  quests:
  - questId: bounty_river_frogs
    title: Clear the Riverbed Frogs
    source: BywaterNoticeBoard
    description: Giant frogs along the Bywater riverbanks have been ambushing ferrymen
      and pulling livestock into the reeds. Thin their numbers before dusk.
    targetMonsterId: giant_frog
    targetCount: 4
    goldReward: 120
    xpReward: 150
    locationHint: Bywater Riverbanks (East & South Meadows)
    isNoticeBoardBounty: 1
    rewardItemId: 905
  - questId: bounty_road_goblins
    title: Break the Road Goblin Ambush
    source: BywaterNoticeBoard
    description: Goblin raiders have been harassing merchant wagons along the trade
      road outside Bywater Gate. Drive them off the road.
    targetMonsterId: goblin
    targetCount: 6
    goldReward: 140
    xpReward: 180
    locationHint: Bywater Trade Road & Foothills
    isNoticeBoardBounty: 1
    rewardItemId: 902
  - questId: bounty_thornwood_orcs
    title: Push Back the Thornwood Orcs
    source: BywaterNoticeBoard
    description: Heavy orc warriors have set up camp in the Thornwood approaches.
      Break their warband and claim the magistrate's bounty.
    targetMonsterId: orc_warrior
    targetCount: 3
    goldReward: 180
    xpReward: 220
    locationHint: Thornwood Forest & Outlying Woods
    isNoticeBoardBounty: 1
    rewardItemId: 455
  - questId: bounty_cavern_undead
    title: Purge the Cavern Undead
    source: BywaterNoticeBoard
    description: Restless skeletal warriors patrol the upper chambers of the Bywater
      Cavern. Put them back to rest and report to the Magistrate.
    targetMonsterId: skeletal_warrior
    targetCount: 5
    goldReward: 200
    xpReward: 250
    locationHint: Bywater Cavern (Dungeon Level 0)
    isNoticeBoardBounty: 1
    rewardItemId: 912
