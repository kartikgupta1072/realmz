{
  "realmz-session-status": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./hooks/session_status.py",
        "timeout": 10
      }
    ]
  },
  "realmz-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/guard_command.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "realmz-file-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/guard_file_edit.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
